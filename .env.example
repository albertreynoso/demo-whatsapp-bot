# Copia este archivo a .env y completa. Nunca subas .env a GitHub.

# Gemini (aistudio.google.com → Get API key). Tiene capa gratuita.
GEMINI_API_KEY=
# Modelo. Por defecto gemini-3.5-flash-lite (rápido y barato). Más capaz: gemini-3.8-flash (en la capa gratuita suele estar saturado)
GEMINI_MODEL=gemini-3.5-flash-lite

PORT=3000

# WhatsApp Cloud API (developers.facebook.com → tu app → WhatsApp → Configuración de la API)
# Si faltan, el webhook se desactiva y solo funciona el chat web.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=elige-un-texto-largo-al-azar
GRAPH_API_VERSION=v23.0
# Número de recepción que recibe los avisos de derivación (formato 51987654321)
RECEPCION_WHATSAPP=

# Google Sheets (opcional). Sin esto, las citas se guardan en data/citas.json
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=./credenciales-google.json
